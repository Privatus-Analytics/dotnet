@section Head {
  <privatus-analytics />
}
<button privatus-event="Export CSV" privatus-prop-format="csv" privatus-prop-source="toolbar">Export</button>
<form method="post" action="/signup" privatus-event="Signup" privatus-props='new { Plan = "pro", Seats = 3 }'><input name="email"></form>
<span id="empty" privatus-event="  ">Nothing</span>
